{
  "name": "lzz-voice",
  "version": "1.0.1",
  "description": "Aplicativo privado de voz e texto LZZ Voice",
  "main": "electron-main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "pc": "electron .",
    "build-pc": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcello-ribeiro/LZZ-Voice.git"
  },
  "keywords": [
    "voice",
    "chat",
    "webrtc",
    "electron",
    "capacitor"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Marcello-ribeiro/LZZ-Voice/issues"
  },
  "homepage": "https://github.com/Marcello-ribeiro/LZZ-Voice#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lzz.voice",
    "productName": "LZZ Voice",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "directories": {
      "output": "dist-pc2"
    },
    "files": [
      "www/**/*",
      "electron-main.js",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LZZ Voice",
      "installerIcon": "build/favicon.ico",
      "uninstallerIcon": "build/favicon.ico",
      "installerHeaderIcon": "build/favicon.ico"
    }
  }
}