{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "www",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}